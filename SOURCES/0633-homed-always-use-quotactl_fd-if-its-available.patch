                         break;
@@ -169,7 +169,7 @@ int home_create_directory_or_subvolume(UserRecord *h, HomeSetup *setup, UserReco
                 if (mkdir(d, 0700) < 0)
                         return log_error_errno(errno, "Failed to create temporary home directory %s: %m", d);
 
-                (void) home_update_quota_classic(h, d);
