From becd7e1a6211e5415a72e73adac335f7ef6f7ca8 Mon Sep 17 00:00:00 2001
From: Michal Sekletar <msekleta@redhat.com>
Date: Thu, 29 Oct 2026 11:29:27 +0100
Subject: [PATCH] gpt-auto-generator: allow disabling auto-mounting of /var

rhel-only: feature

Related: RHEL-303708
---
 man/systemd-gpt-auto-generator.xml          | 11 +++++++++++
 src/gpt-auto-generator/gpt-auto-generator.c | 14 +++++++++++++-
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/man/systemd-gpt-auto-generator.xml b/man/systemd-gpt-auto-generator.xml
index ecf77a9c44..a9a3a45248 100644
--- a/man/systemd-gpt-auto-generator.xml
+++ b/man/systemd-gpt-auto-generator.xml
@@ -287,6 +287,17 @@
         <para>Note that this option is specific to Red Hat Enterprise Linux 9 and is not available in upstream
         systemd. It will not be supported in newer Red Hat Enterprise Linux versions.</para></listitem>
       </varlistentry>
+
+      <varlistentry>
+        <term><varname>systemd.rhel.gpt_auto_var=</varname></term>
+
+        <listitem><para>Takes a boolean argument or enables the option if specified without an argument.
+        If disabled, automatic discovery of the variable data partition based on GPT partition type is
+        disabled, i.e. <filename>/var/</filename> is not mounted automatically. Defaults to enabled.</para>
+
+        <para>Note that this option is specific to Red Hat Enterprise Linux 9 and is not available in upstream
+        systemd. It will not be supported in newer Red Hat Enterprise Linux versions.</para></listitem>
+      </varlistentry>
     </variablelist>
   </refsect1>
 
diff --git a/src/gpt-auto-generator/gpt-auto-generator.c b/src/gpt-auto-generator/gpt-auto-generator.c
index 7bd71ffa98..e97367f803 100644
--- a/src/gpt-auto-generator/gpt-auto-generator.c
+++ b/src/gpt-auto-generator/gpt-auto-generator.c
@@ -42,6 +42,7 @@ static bool arg_enabled = true;
 static bool arg_root_enabled = true;
 static bool arg_swap_enabled = true;
 static bool arg_rhel_home_enabled = true;
+static bool arg_rhel_var_enabled = true;
 static int arg_root_rw = -1;
 
 static int add_cryptsetup(
@@ -745,7 +746,7 @@ static int enumerate_partitions(dev_t devnum) {
                         r = k;
         }
 
-        if (m->partitions[PARTITION_VAR].found) {
+        if (m->partitions[PARTITION_VAR].found && arg_rhel_var_enabled) {
                 k = add_partition_mount(m->partitions + PARTITION_VAR, "var", "/var", "Variable Data Partition");
                 if (k < 0)
                         r = k;
@@ -869,6 +870,17 @@ static int parse_proc_cmdline_item(const char *key, const char *value, void *dat
                 if (!arg_rhel_home_enabled)
                         log_debug("Disabling home partition auto-detection, systemd.rhel.gpt_auto_home=no is defined.");
 
+        } else if (proc_cmdline_key_streq(key, "systemd.rhel.gpt_auto_var")) {
+
+                r = value ? parse_boolean(value) : 1;
+                if (r < 0)
+                        log_warning_errno(r, "Failed to parse gpt-auto var switch \"%s\", ignoring: %m", value);
+                else
+                        arg_rhel_var_enabled = r;
+
+                if (!arg_rhel_var_enabled)
+                        log_debug("Disabling var partition auto-detection, systemd.rhel.gpt_auto_var=no is defined.");
+
         }
 
         return 0;
