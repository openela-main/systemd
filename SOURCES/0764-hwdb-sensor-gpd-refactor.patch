+sensor:modalias:acpi:MXC6655:*:dmi:*:svnGPD:pnG1628-04:*    # Pocket 4
  ACCEL_MOUNT_MATRIX=-1, 0, 0; 0, 1, 0; 0, 0, 1
 
-# GPD Pocket 4
-sensor:modalias:acpi:MXC6655*:dmi:*:svnGPD:pnG1628-04:*
