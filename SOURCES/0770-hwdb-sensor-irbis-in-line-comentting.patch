 hwdb.d/60-sensor.hwdb | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/hwdb.d/60-sensor.hwdb b/hwdb.d/60-sensor.hwdb
index 519ff1429c..8ce4654440 100644
--- a/hwdb.d/60-sensor.hwdb
+++ b/hwdb.d/60-sensor.hwdb
@@ -578,20 +578,16 @@ sensor:modalias:acpi:BMA250:*:dmi:*:bvritWORKS.G.WI71C.JGBMRB*:*:svnInsyde:pni71
 # Irbis
 #########################################
 
-#TW43
-sensor:modalias:acpi:BMA250E*:dmi:*:svnIRBIS:pnTW43:*
+sensor:modalias:acpi:BMA250E:*:dmi:*:svnIRBIS:pnTW43:*      # TW43
