From 914d69c4e8de23fb0845bc0e12e92f4b31af36a6 Mon Sep 17 00:00:00 2001
From: Michal Sekletar <msekleta@redhat.com>
Date: Mon, 9 Nov 2026 17:32:16 +0100
Subject: [PATCH] gpt-auto-generator: allow disabling auto-mounting of ESP

rhel-only: feature

Related: RHEL-303708
---
 man/systemd-gpt-auto-generator.xml          | 12 ++++++++++++
 src/gpt-auto-generator/gpt-auto-generator.c | 14 +++++++++++++-
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/man/systemd-gpt-auto-generator.xml b/man/systemd-gpt-auto-generator.xml
index 7599c91eb0..5647d71fea 100644
--- a/man/systemd-gpt-auto-generator.xml
+++ b/man/systemd-gpt-auto-generator.xml
@@ -320,6 +320,18 @@
         <para>Note that this option is specific to Red Hat Enterprise Linux 9 and is not available in upstream
         systemd. It will not be supported in newer Red Hat Enterprise Linux versions.</para></listitem>
       </varlistentry>
+
+      <varlistentry>
+        <term><varname>systemd.rhel.gpt_auto_esp=</varname></term>
+
+        <listitem><para>Takes a boolean argument or enables the option if specified without an argument.
+        If disabled, automatic discovery of the EFI System Partition (ESP) based on GPT partition type is
+        disabled, i.e. the ESP is not mounted automatically to <filename>/efi/</filename> or
+        <filename>/boot/</filename>. Defaults to enabled.</para>
+
+        <para>Note that this option is specific to Red Hat Enterprise Linux 9 and is not available in upstream
+        systemd. It will not be supported in newer Red Hat Enterprise Linux versions.</para></listitem>
+      </varlistentry>
     </variablelist>
   </refsect1>
 
diff --git a/src/gpt-auto-generator/gpt-auto-generator.c b/src/gpt-auto-generator/gpt-auto-generator.c
index 53002920c9..04afc75ebf 100644
--- a/src/gpt-auto-generator/gpt-auto-generator.c
+++ b/src/gpt-auto-generator/gpt-auto-generator.c
@@ -45,6 +45,7 @@ static bool arg_rhel_home_enabled = true;
 static bool arg_rhel_var_enabled = true;
 static bool arg_rhel_srv_enabled = true;
 static bool arg_rhel_tmp_enabled = true;
+static bool arg_rhel_esp_enabled = true;
 static int arg_root_rw = -1;
 
 static int add_cryptsetup(
@@ -730,7 +731,7 @@ static int enumerate_partitions(dev_t devnum) {
                         r = k;
         }
 
-        if (m->partitions[PARTITION_ESP].found) {
+        if (m->partitions[PARTITION_ESP].found && arg_rhel_esp_enabled) {
                 k = add_partition_esp(m->partitions + PARTITION_ESP, m->partitions[PARTITION_XBOOTLDR].found);
                 if (k < 0)
                         r = k;
@@ -905,6 +906,17 @@ static int parse_proc_cmdline_item(const char *key, const char *value, void *dat
                 if (!arg_rhel_tmp_enabled)
                         log_debug("Disabling tmp partition auto-detection, systemd.rhel.gpt_auto_tmp=no is defined.");
 
+        } else if (proc_cmdline_key_streq(key, "systemd.rhel.gpt_auto_esp")) {
+
+                r = value ? parse_boolean(value) : 1;
+                if (r < 0)
+                        log_warning_errno(r, "Failed to parse gpt-auto esp switch \"%s\", ignoring: %m", value);
+                else
+                        arg_rhel_esp_enabled = r;
+
+                if (!arg_rhel_esp_enabled)
+                        log_debug("Disabling ESP partition auto-detection, systemd.rhel.gpt_auto_esp=no is defined.");
+
         }
 
         return 0;
