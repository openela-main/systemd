-sensor:modalias:acpi:BMA250E*:dmi:*:svnInsyde*:pni101c:*
- ACCEL_MOUNT_MATRIX=0,1,0;-1,0,0;-1,0,0
+sensor:modalias:acpi:BMA250E:*:dmi:*:svnInsyde*:pni101c:*
