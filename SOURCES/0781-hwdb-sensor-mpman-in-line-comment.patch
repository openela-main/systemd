Date: Tue, 17 Feb 2026 01:12:44 +0100
Subject: [PATCH] hwdb: sensor: mpman in-line comment

(cherry picked from commit c0206559986928752156d0ee20523585afa2910d)

Related: RHEL-72703
---
 hwdb.d/60-sensor.hwdb | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/hwdb.d/60-sensor.hwdb b/hwdb.d/60-sensor.hwdb
index 892eb20606..ba3e662f3e 100644
--- a/hwdb.d/60-sensor.hwdb
+++ b/hwdb.d/60-sensor.hwdb
@@ -778,12 +778,10 @@ sensor:modalias:acpi:KIOX000A:*:dmi:*:svnMicrotech:pne-tabPro:*    # Microtech e
 # MPMAN
 #########################################
 
-# MPMAN Converter 9, same hw as the I.T.Works TW891 2-in-1
-sensor:modalias:acpi:SMO8500*:dmi:*:svnMPMAN:pnConverter9:*
+sensor:modalias:acpi:SMO8500:*:dmi:*:svnMPMAN:pnConverter9:*     # Converter 9, same hw as the I.T.Works TW891 2-in-1
  ACCEL_MOUNT_MATRIX=0, 1, 0; 1, 0, 0; 0, 0, 1
 
-# MPMAN MPWIN895C
-sensor:modalias:acpi:BMA250E*:dmi:*:svnMPMAN:pnMPWIN8900CL:*
+sensor:modalias:acpi:BMA250E:*:dmi:*:svnMPMAN:pnMPWIN8900CL:*    # MPWIN895C
  ACCEL_MOUNT_MATRIX=1, 0, 0; 0, -1, 0; 0, 0, 1
 
 #########################################
