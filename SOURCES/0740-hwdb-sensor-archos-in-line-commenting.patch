From: =?UTF-8?q?David=20Santamar=C3=ADa=20Rogado?= <howl.nsp@gmail.com>
Date: Sun, 15 Feb 2026 06:01:26 +0100
Subject: [PATCH] hwdb: sensor: archos in-line commenting

(cherry picked from commit f59346ed42810b334e5c2f99934f39360abab9cc)

Related: RHEL-72703
---
 hwdb.d/60-sensor.hwdb | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/hwdb.d/60-sensor.hwdb b/hwdb.d/60-sensor.hwdb
index 1cb78588bd..6f7559b58b 100644
--- a/hwdb.d/60-sensor.hwdb
+++ b/hwdb.d/60-sensor.hwdb
@@ -123,14 +123,11 @@ sensor:modalias:acpi:MXC6655:*:dmi:*:svnAquarius:pnCmpNS483:*    # Cmp NS483 v2
 # Archos
 #########################################
 
-# Archos 80 Cesium
-sensor:modalias:acpi:SMO8500*:dmi:*:svnARCHOS:pnARCHOS80Cesium:*
-# Archos 101 Cesium
-sensor:modalias:acpi:KIOX000A*:dmi:*:svnARCHOS:pnARCHOS101CESIUM:*
+sensor:modalias:acpi:SMO8500:*:dmi:*:svnARCHOS:pnARCHOS80Cesium:*          # 80 Cesium
+sensor:modalias:acpi:KIOX000A:*:dmi:*:svnARCHOS:pnARCHOS101CESIUM:*        # 101 Cesium
  ACCEL_MOUNT_MATRIX=-1, 0, 0; 0, 1, 0; 0, 0, 1
 
-# Archos 101 Cesium Educ
-sensor:modalias:acpi:KIOX000A*:dmi:*:svnARCHOS:pnARCHOS101CesiumEduc:*
+sensor:modalias:acpi:KIOX000A:*:dmi:*:svnARCHOS:pnARCHOS101CesiumEduc:*    # 101 Cesium Educ
  ACCEL_MOUNT_MATRIX=1, 0, 0; 0, -1, 0; 0, 0, 1
 
 #########################################
