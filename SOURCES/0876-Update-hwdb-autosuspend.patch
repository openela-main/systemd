Subject: [PATCH] Update hwdb autosuspend

ninja -C build update-hwdb-autosuspend

(cherry picked from commit 9decc099ce04637612a1f32d8eea82224a11ece0)

Related: RHEL-72703
---
 hwdb.d/60-autosuspend-fingerprint-reader.hwdb | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/hwdb.d/60-autosuspend-fingerprint-reader.hwdb b/hwdb.d/60-autosuspend-fingerprint-reader.hwdb
index 32bfa5ad7b..e9d7311fea 100644
--- a/hwdb.d/60-autosuspend-fingerprint-reader.hwdb
+++ b/hwdb.d/60-autosuspend-fingerprint-reader.hwdb
@@ -81,6 +81,12 @@ usb:v1C7Ap0571*
  ID_AUTOSUSPEND=1
  ID_PERSIST=0
 
+# Supported by libfprint driver egis_etu905
+usb:v1C7Ap05AE*
+usb:v1C7Ap9201*
+ ID_AUTOSUSPEND=1
+ ID_PERSIST=0
+
 # Supported by libfprint driver egismoc
 usb:v1C7Ap0582*
 usb:v1C7Ap0583*
@@ -189,9 +195,11 @@ usb:v2808pA959*
 usb:v2808pA99A*
