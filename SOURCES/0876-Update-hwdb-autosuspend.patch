+usb:v2808p5158*
  ID_AUTOSUSPEND=1
  ID_PERSIST=0
 
@@ -245,6 +253,7 @@ usb:v27C6p6512*
 usb:v27C6p6890*
 usb:v27C6p689A*
 usb:v27C6p66A9*
+usb:v27C6p6984*
